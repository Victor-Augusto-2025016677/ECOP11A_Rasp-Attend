[Unit]
Description=Backend em C para Monitoramento Nodogsplash (backendc1)
After=network.target nodogsplash.service

[Service]
Type=simple
ExecStart=/etc/sistema_presenca/codigo-c/bin/monitor_c
User=root
Group=root
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backendc1

[Install]
WantedBy=multi-user.target